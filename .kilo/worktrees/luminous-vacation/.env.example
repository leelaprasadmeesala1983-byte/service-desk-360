# Postgres connection string used by Drizzle and better-auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_desk

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public origin of the app; also used as a trusted origin for auth requests.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000


# whatsapp integraton with meta
WHATSAPP_PHONE_NUMBER_ID=your_id
WHATSAPP_ACCESS_TOKEN=your_token
WHATSAPP_APP_URL=https://yourapp.com