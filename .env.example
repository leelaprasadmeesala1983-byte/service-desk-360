# Postgres connection string used by Drizzle and better-auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_desk

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public origin of the app; also used as a trusted origin for auth requests.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_ENABLED=true

# WhatsApp template SIDs (Twilio Content Template Builder).
# Leave a SID blank to send free-form text (Twilio sandbox / 24h window).
TWILIO_TEMPLATE_TICKET_CREATED=
TWILIO_TEMPLATE_TICKET_ASSIGNED_CUSTOMER=
TWILIO_TEMPLATE_TICKET_ASSIGNED_TECHNICIAN=
TWILIO_TEMPLATE_USER_CREDENTIALS=
TWILIO_TEMPLATE_SERVICE_ASSIGNMENT=
TWILIO_TEMPLATE_INSTALLATION_TECHNICIAN=
TWILIO_TEMPLATE_INSTALLATION_CUSTOMER=
TWILIO_TEMPLATE_PROJECT_TECHNICIAN=
TWILIO_TEMPLATE_PROJECT_CUSTOMER=

# App URL (for deep links in WhatsApp messages)
APP_URL=https://yourapp.com

# AWS S3 (file uploads: service ticket images, project PDFs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
