# Postgres connection string used by Drizzle and better-auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_desk

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public origin of the app; also used as a trusted origin for auth requests.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# WhatsApp (Meta Cloud API) Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_SUPPORT_PHONE=

# Approved template NAMES from WhatsApp Manager.
# Leave a name blank to send free-form text (only delivered inside the 24h window).
WHATSAPP_TEMPLATE_TICKET_CREATED=ticket_created
WHATSAPP_TEMPLATE_USER_CREDENTIALS=user_creation

WHATSAPP_TEMPLATE_SERVICE_TECHNICIAN=service_ticket_assigned
WHATSAPP_TEMPLATE_SERVICE_CUSTOMER=ticket_assigned_customer

WHATSAPP_TEMPLATE_INSTALLATION_TECHNICIAN=installation_assigned_technician
WHATSAPP_TEMPLATE_INSTALLATION_CUSTOMER=installation_scheduled_customer

WHATSAPP_TEMPLATE_PROJECT_TECHNICIAN=project_assigned_technician
WHATSAPP_TEMPLATE_PROJECT_CUSTOMER=project_assigned_customer

# App URL (for deep links in WhatsApp messages)
APP_URL=https://yourapp.com

# AWS S3 (file uploads: service ticket images, project PDFs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
